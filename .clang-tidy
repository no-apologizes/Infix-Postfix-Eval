Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -altera-*,
  -llvmlibc-*,
  -llvm-*,
  -fuchsia-*,
  -zircon-*,
  -objc-*,
  -darwin-*,
  -google-*,
  -abseil-*,
  -android-*,
  -modernize-*,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -readability-magic-numbers

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: none